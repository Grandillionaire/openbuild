{
  "name": "openbuild",
  "version": "2.0.0",
  "description": "OpenBuild — open-source visual website builder with built-in commerce. A free, self-hostable alternative to Squarespace.",
  "keywords": [
    "website-builder",
    "drag-and-drop",
    "no-code",
    "low-code",
    "vue3",
    "typescript",
    "squarespace-alternative",
    "ecommerce",
    "stripe",
    "open-source"
  ],
  "license": "MIT",
  "author": "Grandillionaire (Maximillian Grand)",
  "repository": {
    "type": "git",
    "url": "https://github.com/Grandillionaire/openbuild.git"
  },
  "homepage": "https://github.com/Grandillionaire/openbuild",
  "bugs": "https://github.com/Grandillionaire/openbuild/issues",
  "type": "module",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint . --max-warnings=300",
    "lint:strict": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,vue,js,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,vue,js,json,css,md}\"",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "test:e2e:ui": "playwright test -c e2e/playwright.config.ts --ui",
    "check": "npm run lint && npm run typecheck && npm run test -- --run && npm run build",
    "bundle:budget": "node scripts/check-bundle-budget.mjs",
    "licenses": "node scripts/check-licenses.mjs",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.10",
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.0",
    "@formkit/drag-and-drop": "^0.1.6",
    "@vueuse/core": "^10.7.0",
    "codemirror": "^6.0.1",
    "dexie": "^3.2.4",
    "file-saver": "^2.0.5",
    "handlebars": "^4.7.8",
    "jszip": "^3.10.1",
    "lucide-vue-next": "^0.298.0",
    "nanoid": "^5.0.4",
    "pinia": "^2.1.7",
    "vanilla-colorful": "^0.7.2",
    "vue": "^3.4.0",
    "vue-codemirror": "^6.1.1",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "@playwright/test": "^1.40.0",
    "@testing-library/vue": "^8.1.0",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^20.10.5",
    "@unocss/reset": "^0.58.0",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vitest/coverage-v8": "^3.2.4",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.16.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-vue": "^9.32.0",
    "globals": "^15.13.0",
    "happy-dom": "^20.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "prettier": "^3.1.1",
    "terser": "^5.44.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.18.0",
    "unocss": "^66.6.0",
    "vite": "^7.3.1",
    "vitest": "^3.2.4",
    "vue-eslint-parser": "^9.4.3",
    "vue-tsc": "^3.0.7"
  },
  "lint-staged": {
    "*.{ts,tsx,vue,js}": ["eslint --fix", "prettier --write"],
    "*.{json,md,css}": ["prettier --write"]
  }
}
